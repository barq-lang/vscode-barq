{
  "name": "barq-vscode",
  "displayName": "Barq",
  "description": "Barq (برق) language support: completion, hover, go to definition, references, rename and inline errors from the Barq language server, formatting, snippets, outline and run commands.",
  "version": "0.2.0",
  "publisher": "barq-lang",
  "license": "MIT",
  "icon": "icons/barq.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/barq-lang/vscode-barq"
  },
  "bugs": {
    "url": "https://github.com/barq-lang/vscode-barq/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Formatters", "Linters", "Snippets"],
  "keywords": ["barq", "bq", "برق"],
  "main": "./src/extension.js",
  "activationEvents": ["workspaceContains:**/*.bq", "onLanguage:barq"],
  "contributes": {
    "languages": [
      {
        "id": "barq",
        "aliases": ["Barq", "barq"],
        "extensions": [".bq"],
        "configuration": "./language-configuration.json",
        "icon": { "light": "./icons/bq-file.svg", "dark": "./icons/bq-file.svg" }
      },
      {
        "id": "barq-template",
        "aliases": ["Barq Template", "barq-template"],
        "filenamePatterns": ["**/views/**/*.bq"],
        "configuration": "./template-configuration.json",
        "icon": { "light": "./icons/bq-file.svg", "dark": "./icons/bq-file.svg" }
      }
    ],
    "grammars": [
      { "language": "barq", "scopeName": "source.barq", "path": "./syntaxes/barq.tmLanguage.json" },
      {
        "language": "barq-template",
        "scopeName": "text.html.barq",
        "path": "./syntaxes/barq-template.tmLanguage.json",
        "embeddedLanguages": { "source.barq.embedded": "barq", "source.css": "css", "source.js": "javascript" }
      },
      {
        "scopeName": "barq.template.injection",
        "path": "./syntaxes/barq-template-injection.tmLanguage.json",
        "injectTo": ["text.html.barq"]
      }
    ],
    "snippets": [{ "language": "barq", "path": "./snippets/barq.json" }],
    "commands": [
      { "command": "barq.runFile", "title": "Barq: Run current file", "icon": "$(play)" },
      { "command": "barq.serve", "title": "Barq: Serve project (barq serve)" },
      { "command": "barq.test", "title": "Barq: Run project tests (barq test)" },
      { "command": "barq.checkWorkspace", "title": "Barq: Check every file in the workspace" },
      { "command": "barq.repl", "title": "Barq: Open REPL" },
      { "command": "barq.packages", "title": "Barq: Show installed packages" },
      { "command": "barq.restartServer", "title": "Barq: Restart language server" }
    ],
    "menus": {
      "editor/title/run": [{ "command": "barq.runFile", "when": "resourceLangId == barq" }]
    },
    "configurationDefaults": {
      "[barq]": { "editor.formatOnSave": true, "editor.tabSize": 4, "editor.insertSpaces": true }
    },
    "configuration": {
      "title": "Barq",
      "properties": {
        "barq.path": {
          "type": "string",
          "default": "barq",
          "description": "The barq command (or a full path to bin/barq in a barq checkout)."
        },
        "barq.languageServer.enable": {
          "type": "boolean",
          "default": true,
          "description": "Use the Barq language server (`barq lsp`, Barq 0.19.0+) for completion, hover, go to definition, references, rename and errors. When off, or with an older barq, only formatting, errors and the outline work (through barq fmt / barq check)."
        },
        "barq.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show syntax and type errors from `barq check` as you work."
        },
        "barq.diagnostics.onType": {
          "type": "boolean",
          "default": true,
          "description": "Check while typing (after a short pause), not only on save."
        },
        "barq.format.indentSize": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 8,
          "description": "Spaces per indentation level for `barq fmt`."
        },
        "barq.format.sortImports": {
          "type": "boolean",
          "default": true,
          "description": "Sort runs of top-level `use` lines when formatting."
        },
        "barq.run.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra arguments passed to `barq run` (after the file)."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/run.js && node test/activate.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  }
}
